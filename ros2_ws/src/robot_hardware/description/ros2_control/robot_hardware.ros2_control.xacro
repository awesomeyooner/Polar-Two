<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="robot_hardware_ros2_control" params="name prefix">

    <xacro:property name="speed_multiplier" value="1"/>
    
    <xacro:macro name="front_wheel" params="name">

        <joint name="${name}_wheel_joint">
            <command_interface name="velocity"/>

            <!-- RC car doesn't have feedback -->
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="position"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>

        <joint name="${name}_steer_joint">
            <command_interface name="position"/>

            <!-- <state_interface name="position"/> -->
            <state_interface name="effort"/>
        </joint>

    </xacro:macro>

    <xacro:macro name="rear_wheel" params="name">

        <joint name="${name}_wheel_joint">
            <command_interface name="velocity"/>

            <!-- RC car doesn't have feedback -->
            <!-- <state_interface name="velocity"/> -->
            <state_interface name="position"/>
            <!-- <state_interface name="effort"/> -->
        </joint>

    </xacro:macro>

    <!-- If NOT Sim Mode (Real Mode) -->
    <xacro:unless value="$(arg sim_mode)">

        <ros2_control name="${name}" type="system">

            <hardware>
                <plugin>robot_hardware/RobotSystemHardware</plugin>

                <!-- For initializing the serial port -->
                <param name="MCU_field">product</param>
                <param name="MCU_description">STM32 Virtual ComPort</param>

                <!-- <param name="my_int_param">0</param> -->
                <!-- <param name="my_string_param">Hello World</param> -->
            </hardware>

            <xacro:front_wheel name="${prefix}front_left"/>
            <xacro:front_wheel name="${prefix}front_right"/>

            <xacro:rear_wheel name="${prefix}rear_left"/>
            <xacro:rear_wheel name="${prefix}rear_right"/>

        </ros2_control>

    </xacro:unless>

    <!-- If Sim Mode -->
    <xacro:if value="$(arg sim_mode)">

        <!-- Setup ros2_control -->
        <ros2_control name="GazeboSimSystem" type="system">
      
            <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
    
            <!-- drive joint -->
            <joint name="${prefix}virtual_rear_wheel_joint">
    
            <command_interface name="velocity">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
    
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
                

            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
                
            </joint>

            <joint name="${prefix}rear_left_wheel_joint">

            <param name="mimic">virtual_rear_wheel_joint</param>
            <param name="multiplier">${speed_multiplier}</param>
    
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
                

            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
                
            </joint>

            <joint name="${prefix}rear_right_wheel_joint">

            <param name="mimic">virtual_rear_wheel_joint</param>
            <param name="multiplier">${speed_multiplier}</param>
    
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
                
            </joint>
    
            <!-- steer joint -->
            <joint name="${prefix}virtual_front_wheel_joint">
    
            <command_interface name="position">
                <param name="min">-1000</param>
                <param name="max">1000</param>
            </command_interface>
            
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
    
            </joint>

            <joint name="${prefix}front_right_wheel_joint">

            <param name="mimic">virtual_rear_wheel_joint</param>
            <param name="multiplier">${speed_multiplier}</param>
    
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
    
            </joint>

            <joint name="${prefix}front_left_wheel_joint">

            <param name="mimic">virtual_rear_wheel_joint</param>
            <param name="multiplier">${speed_multiplier}</param>

            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
    
            </joint>

            <joint name="${prefix}front_left_steer_joint">

            <param name="mimic">virtual_front_wheel_joint</param>
            <param name="multiplier">1</param>
            
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
    
            </joint>

            <joint name="${prefix}front_right_steer_joint">

            <param name="mimic">virtual_front_wheel_joint</param>
            <param name="multiplier">1</param>
            
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>

            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
    
            </joint>
    
        </ros2_control>
  
        <!-- Setup Gazebo -->
        <gazebo>
            <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
                <!-- Controller Settings -->
                <parameters>$(find robot_hardware)/bringup/config/robot_hardware_controllers.yaml</parameters>

                <!-- Enables Sim Time = True -->
                <parameters>$(find robot_hardware)/bringup/config/gazebo_controller.yaml</parameters>
            </plugin>
        </gazebo>

    </xacro:if>

</xacro:macro>

</robot>
