<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="rear_wheel" params="name x y z side">

        <link name="${name}_wheel">

            <!-- COLLISION -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <mesh filename="file://$(find robot_hardware)/urdf/meshes/Wheel.stl"/>
                </geometry>

                <surface>
                    <friction>
                        <ode>
                        <mu value="${friction}"/>
                        <mu2 value="${friction}"/>
                        </ode>
                    </friction>
                </surface>
            </collision>
    
            <!-- VISIUAL -->
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <mesh filename="file://$(find robot_hardware)/urdf/meshes/Wheel.stl"/>
                </geometry>

                <material name="black"/>
            </visual>
    
            <!-- INERTIAL -->
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${wheel_mass}"/>
                <inertia
                    ixx="0.000270" ixy="0.0" ixz="0.0"
                    iyy="0.000270" iyz="0.0"
                    izz="0.000426"/>
            </inertial>
        </link>

        <gazebo reference="${name}_wheel">
            <material>Gazebo/Black</material>
        </gazebo>

        <!-- Spinning Joint -->
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="${prefix}chassis_link"/>
            <child link="${name}_wheel"/>
            <origin xyz="${x} ${y} ${z}" rpy="${side * -PI / 2} 0 0"/>
            <axis xyz="0 0 ${side}"/>
            <dynamics damping="${damping}"/>
        </joint>

    </xacro:macro>

</robot>